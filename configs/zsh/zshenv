# ~/.zshenv — 모든 zsh 인스턴스(로그인/비로그인/대화형/비대화형)에서 가장 먼저 읽힘
#
# 로케일은 tmux 같은 데몬에도 상속되어야 멀티바이트(이모지 등)가 깨지지 않으므로,
# .zshrc 가 아닌 .zshenv 에 설정한다.

# UTF-8 로케일 — 미설정 시 C 로케일로 떨어져 tmux 가 비-UTF-8 모드로 동작한다.
# LC_* 카테고리를 따로 지정하지 않으면 LANG 이 그 기본값이 되므로 LANG 하나로 충분하다.
export LANG=en_US.UTF-8

# 머신별 환경변수(토큰, 경로 등) — 버전 관리 제외
[[ -f "$HOME/.zshenv.local" ]] && source "$HOME/.zshenv.local"
