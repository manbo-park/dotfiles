# Aliases
alias dv='cd ~/Desktop/dv'
alias gb='git branch'
alias gco='git checkout'
alias gpl='git pull'
alias gplo='git pull origin'
alias gps='git push'
alias gpso='git push origin'
alias gs='git switch'
alias mux='tmuxinator'

# WSL: ssh-agent 자동 시작
## WSL은 터미널 세션이 끝나면 ssh-agent도 함께 죽는 경우가 많아,
## 세션마다 SSH_AUTH_SOCK이 비어 있으면 새로 띄우고 키를 등록한다.
if grep -qi microsoft /proc/version 2>/dev/null; then
  if [ -z "$SSH_AUTH_SOCK" ]; then
    eval "$(ssh-agent -s)" > /dev/null
    ssh-add ~/.ssh/id_ed25519 2>/dev/null
  fi
fi

# Plugins
## fzf-tab / zsh-autosuggestions / zsh-syntax-highlighting
## pcfg가 git clone으로 설치한 경로(~/.zsh/plugins)를 우선 사용하고,
## 없으면 macOS(Homebrew) 경로로 폴백한다.
autoload -U compinit; compinit

_zsh_plugin_source() {
  local name="$1" file="$2"
  local cloned="${HOME}/.zsh/plugins/${name}/${file}"
  if [[ -f "$cloned" ]]; then
    source "$cloned"
  elif command -v brew &>/dev/null && [[ -f "$(brew --prefix)/share/${name}/${file}" ]]; then
    source "$(brew --prefix)/share/${name}/${file}"
  fi
}

_zsh_plugin_source fzf-tab fzf-tab.zsh
_zsh_plugin_source zsh-autosuggestions zsh-autosuggestions.zsh
_zsh_plugin_source zsh-syntax-highlighting zsh-syntax-highlighting.zsh
unfunction _zsh_plugin_source

# fzf-tab configurations
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:*' fzf-flags --color=fg:1,fg+:2 --bind=tab:accept
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup

# Environment Variables
export PATH="$HOME/.local/bin:$PATH"

## gem --user-install(Linux/WSL의 tmuxinator 등)로 설치된 실행 파일 경로를 PATH에 추가
if command -v ruby &>/dev/null; then
  _gem_user_bin="$(ruby -e 'print Gem.user_dir' 2>/dev/null)/bin"
  [[ -d "$_gem_user_bin" ]] && export PATH="$_gem_user_bin:$PATH"
  unset _gem_user_bin
fi

export EDITOR='vim'
export STARSHIP_CONFIG=~/.config/starship/starship.toml

# Starship
eval "$(starship init zsh)"
